+  const [pending, startTransition] = useTransition();
+
+  if (!open) {
+    return (
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        className="button-secondary px-2 py-1 text-xs text-sky-300 hover:text-sky-200"
